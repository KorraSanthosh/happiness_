# GlucoTwin AI - environment variables
#
# The application currently reads NO environment variables: the Vite dev server proxies /api to
# http://localhost:8000 (frontend/vite.config.js) and all paths are relative to the repository.
# Nothing secret is needed to run it. This file only documents the defaults; do not put real secrets here,
# and never commit a real .env file (it is git-ignored).

# Backend address used by the Vite proxy (fixed in frontend/vite.config.js)
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Frontend dev server port (fixed in frontend/vite.config.js)
FRONTEND_PORT=5173
